# ============================================
# Cozy Voice Chat - Frontend Configuration
# ============================================

# IP-адрес хоста в локальной сети
# Узнать: ipconfig (Windows) или ifconfig / ip a (Linux/macOS)
VITE_HOST_IP=192.168.31.231

# Порт backend-сервера (сигнальный + файловый)
VITE_PORT=8080

# Порт PeerJS-сервера (для WebRTC сигнализации)
VITE_PEER_PORT=9000

# ============================================
# SSL Configuration (для HTTPS режима)
# ============================================
# Пути указываются относительно корня frontend/

SSL_KEY_PATH=../cert/192.168.31.231-key.pem
SSL_CERT_PATH=../cert/192.168.31.231.pem

# Использовать https соединение или нет
VITE_SSL=true