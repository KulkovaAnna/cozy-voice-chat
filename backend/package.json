{
  "name": "cozy-voice-chat-backend",
  "version": "1.0.0",
  "description": "Server for local voice chat",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:ssl": "node dist/https-server.js",
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "dev:ssl": "nodemon --watch src --ext ts --exec ts-node src/https-server.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KulkovaAnna/cozy-voice-chat.git"
  },
  "author": "Kulkova Anna",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/KulkovaAnna/cozy-voice-chat/issues"
  },
  "homepage": "https://github.com/KulkovaAnna/cozy-voice-chat#readme",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "lodash": "^4.17.23",
    "mime-types": "^3.0.2",
    "multer": "^2.3.0",
    "prettier": "^3.8.1",
    "rate-limiter-flexible": "^9.0.1",
    "socket.io": "^4.8.3",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.20",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
